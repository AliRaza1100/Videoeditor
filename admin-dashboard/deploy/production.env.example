# EXAMPLE ONLY: replace the domain, email and password before deployment.
# Store the real file at /etc/lumen-admin.env, root-owned with mode 0600.
NODE_ENV=production
HOST=127.0.0.1
PORT=4173
PUBLIC_ORIGIN=https://admin.example.com
LUMEN_DATABASE=/var/lib/lumen-admin/lumen.sqlite
TRUST_LOOPBACK_PROXY=true
LUMEN_ADMIN_EMAIL=owner@example.com
LUMEN_ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_LONG_RANDOM_PASSWORD

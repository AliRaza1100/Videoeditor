[Unit]
Description=Lumen Studio administration API
After=network.target

[Service]
Type=simple
User=lumen
Group=lumen
WorkingDirectory=/opt/lumen/admin-dashboard
EnvironmentFile=/etc/lumen-admin.env
ExecStart=/usr/bin/node server.mjs
Restart=on-failure
RestartSec=5
StateDirectory=lumen-admin
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/lumen-admin

[Install]
WantedBy=multi-user.target
